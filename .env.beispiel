# Vorlage für die Datei .env
#
# Kopieren und die beiden Werte eintragen:
#     cp .env.beispiel .env
#
# Beide Werte stehen im Supabase-Dashboard unter
#     Project Settings -> API
#
# Sie sind NICHT geheim: Sie stecken in jedem ausgelieferten Browser-Bundle
# und damit auf jedem Handy. Der Schutz der Daten kommt aus Row Level
# Security, nicht aus der Geheimhaltung dieser beiden Zeilen.
#
# Der gefährliche Schlüssel heisst SERVICE_ROLE_KEY. Der gehört NICHT hierher,
# sondern ausschliesslich in die Supabase-Secrets der Edge Functions.

VITE_SUPABASE_URL="https://<projekt-kennung>.supabase.co"
VITE_SUPABASE_KEY="<publishable key, beginnt mit sb_publishable_>"
